{
  "name": "rfc-curp-clabe",
  "displayName": "RFC CURP CLABE",
  "description": "RFC, CURP y CLABE en VS Code: explica, valida, corrige el dígito verificador y genera datos de prueba. Todo local.",
  "version": "0.1.1",
  "publisher": "lodi",
  "license": "MIT",
  "icon": "icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ilodi/rfc-curp-clabe"
  },
  "sponsor": {
    "url": "https://paypal.me/lodidev"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "mexico",
    "méxico",
    "rfc",
    "curp",
    "clabe",
    "sat",
    "cfdi",
    "banco",
    "validador",
    "datos de prueba"
  ],
  "galleryBanner": {
    "color": "#1a1d24",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rfcCurpClabe.generar",
        "title": "RFC CURP CLABE: Generar dato de prueba (RFC, CURP, CLABE)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rfcCurpClabe.generar",
          "group": "1_modification@99"
        }
      ]
    },
    "configuration": {
      "title": "RFC CURP CLABE",
      "properties": {
        "rfcCurpClabe.avisos": {
          "type": "boolean",
          "default": true,
          "description": "Subraya los RFC, CURP y CLABE inválidos. Un número de 18 dígitos solo se revisa como CLABE si antes, en la misma línea, dice \"clabe\"."
        }
      }
    }
  }
}
